{
  "manifest_version": 3,
  "name": "EstudoMentor AI",
  "version": "1.1",
  "description": "Assistente de estudos para resolver questões, exercícios, alternativas, cálculos, códigos e correções curtas.",
  "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EstudoMentor AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
