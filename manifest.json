{
  "manifest_version": 3,
  "name": "CodeMentor AI",
  "version": "1.1",
  "description": "Assistente de estudos focado em programação, com explicação de código, exercícios, erros e refatoração.",
  "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CodeMentor AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
